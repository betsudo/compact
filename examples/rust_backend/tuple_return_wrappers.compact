import CompactStandardLibrary;
export ledger values: Set<Field>;
export ledger count: Counter;
export ledger stored: Field;
witness choose(): Boolean;
witness first(): Uint<16>;
witness second(): Uint<16>;
constructor() { stored = 2; values.insert(5); }

export circuit inferred(selected: Boolean, value: Field): [Field, Field] {
  if (disclose(selected)) { values.insert(disclose(value)); return [1, 2]; }
  else { return [0, 0]; }
}
export circuit explicit(selected: Boolean, value: Field): [Field, Field] {
  if (disclose(selected)) {
    values.insert(disclose(value)); return [1 as Field, 2 as Field];
  } else { return [0 as Field, 0 as Field]; }
}
export circuit nested(outer: Boolean, inner: Boolean, value: Field): [Field, Field] {
  if (disclose(outer)) {
    const local = value + 1;
    if (disclose(inner)) { values.insert(disclose(local)); return [local, 3]; }
    else { count.increment(1); return [2 as Field, 4]; }
  } else { return [0 as Field, 5]; }
}
export circuit ordered(value: Field): [Field, Field] {
  if (disclose(choose())) {
    values.insert(disclose(value));
    return [disclose(first()), disclose(second())];
  } else { return [0, 0]; }
}
export circuit checked_first(selected: Boolean, value: Uint<16>): [Field, Field] {
  if (disclose(selected)) {
    count.increment(1); return [value - 1, disclose(second())];
  } else { return [value, 0]; }
}
export circuit checked_second(selected: Boolean, value: Uint<16>): [Field, Field] {
  if (disclose(selected)) {
    count.increment(1); return [disclose(first()), value - 1];
  } else { return [0, value]; }
}
export circuit expression_only(value: Uint<16>): [Field, Field] {
  return [value as Field, (value + 1) as Field];
}

export circuit mixed(selected: Boolean, value: Field): [Uint<8>, Field] {
  if (disclose(selected)) { values.insert(disclose(value)); return [1, 2]; }
  else { return [0, 0]; }
}
export circuit folded(items: Vector<2, Field>): [Field, Field] {
  return fold((acc: [Field, Field], item: Field): [Field, Field] => {
    if (disclose(item == 0)) { values.insert(disclose(item)); return [1, 2]; }
    else { return [0, 0]; }
  }, [0 as Field, 0 as Field], items);
}
