import CompactStandardLibrary;
export ledger seen:Field;
type Item = [Vector<2,[Uint<8>,Uint<8>]>,Uint<16>];
type Input = Vector<2,Item>;
type Output = Vector<2,[Vector<2,[Uint<16>,Uint<16>]>,Uint<32>]>;
export circuit run(input:Input):Output{const wide:Output = input;seen=1;return wide;}
