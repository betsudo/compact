import CompactStandardLibrary;
export ledger seen:Field;
type NarrowLeaf = [Uint<8>,Uint<8>];
type WideLeaf = [Uint<16>,Uint<16>];
export circuit run(input:Vector<2,[Vector<2,NarrowLeaf>,Uint<16>]>):Vector<2,[Vector<2,WideLeaf>,Uint<32>]>{seen=1;return input;}
