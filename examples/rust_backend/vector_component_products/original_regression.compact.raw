import CompactStandardLibrary;
export ledger seen:Field;
export circuit run(input:Vector<2,[Vector<2,[Uint<8>,Uint<8>]>,Uint<8>]>):Vector<2,[Vector<2,[Uint<16>,Uint<16>]>,Uint<16>]>{seen=1;return input;}
