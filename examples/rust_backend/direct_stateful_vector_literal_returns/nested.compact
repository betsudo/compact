import CompactStandardLibrary;
export ledger seen:Field;
export circuit run(input:Vector<2,Vector<2,Uint<8>>>):Vector<2,Vector<2,Uint<16>>>{seen=1;return [[input[0][1],input[0][0]],[input[1][1],input[1][0]]];}
