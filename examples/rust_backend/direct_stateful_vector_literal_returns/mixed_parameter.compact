import CompactStandardLibrary;
export ledger seen:Field;
export circuit run(ok:Boolean,input:Vector<2,Uint<16>>,small:Vector<2,Uint<8>>):Vector<2,Uint<16>>{if(disclose(ok)){seen=1;return [small[1],small[0]];}else{seen=2;return input;}}
