import CompactStandardLibrary;
export ledger seen:Field;
constructor(initialSeen:Field){seen=disclose(initialSeen);}
export circuit run(input:Vector<2,Uint<8>>):Vector<2,Uint<16>>{if(seen==0){seen=1;return [input[1],input[0]];}else{seen=2;return [input[0],input[1]];}}
