import CompactStandardLibrary;
export ledger seen:Field;
pure circuit first(ok:Boolean,input:Vector<2,Uint<8>>):Vector<2,Uint<8>>{assert(ok,"first denied");return input;}
pure circuit second(ok:Boolean,input:Vector<2,Uint<8>>):Vector<2,Uint<8>>{assert(ok,"second denied");return input;}
export circuit run(a:Boolean,b:Boolean,input:Vector<2,Uint<8>>,other:Vector<2,Uint<8>>):Vector<2,Uint<16>>{seen=1;return [first(a,input)[1],second(b,other)[0]];}
