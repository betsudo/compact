import CompactStandardLibrary;
export ledger seen:Field;
pure circuit keep(input:Vector<2,Uint<8>>):Vector<2,Uint<8>>{return input;}
export circuit run(ok:Boolean,input:Vector<2,Uint<8>>):Vector<2,Uint<16>>{if(disclose(ok)){seen=1;return [input[1],input[0]];}else{seen=2;return keep(input);}}
