import CompactStandardLibrary;
export ledger seen:Field;
export circuit run(input:Vector<2,[Uint<8>,Uint<16>]>):[]{const wide:Vector<2,[Uint<16>,Uint<32>]> =input;seen=disclose(wide[1][1]);}
