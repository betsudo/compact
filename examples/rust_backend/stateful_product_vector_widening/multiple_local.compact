import CompactStandardLibrary;
export ledger seen:Field;
export circuit run(input:Vector<2,[Uint<8>,Uint<16>]>):Vector<2,[Field,Field]>{const wide:Vector<2,[Uint<16>,Uint<32>]> =input;seen=1;const fields:Vector<2,[Field,Field]> =wide;seen=2;return fields;}
