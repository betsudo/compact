import CompactStandardLibrary;
export ledger seen:Field;
type Small = Uint<8>;
type Item = [Small,Uint<16>];
type Input = Vector<2,Item>;
type Output = Vector<2,[Uint<16>,Uint<32>]>;
export circuit run(input:Input):Output{seen=1;const wide:Output=input;return wide;}
