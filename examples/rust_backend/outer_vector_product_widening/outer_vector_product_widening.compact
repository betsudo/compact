import CompactStandardLibrary;
export ledger seen: Field;
type Narrow = Vector<2, [[Uint<8>], Uint<8>]>;
type Wide = Vector<2, [[Uint<16>], Uint<16>]>;
pure circuit keep(input: Narrow): Narrow { return input; }
pure circuit checked(ok: Boolean, input: Wide): Narrow {
  assert(ok, "outer Vector product helper denied");
  return [[[input[0][0][0] as Uint<8>], input[0][1] as Uint<8>],
          [[input[1][0][0] as Uint<8>], input[1][1] as Uint<8>]];
}
witness product_value(): Narrow;
export circuit parameter(input: Narrow): Wide { seen = 1; return input; }
export circuit helper(input: Narrow): Wide { seen = 2; return keep(input); }
export circuit local(input: Narrow): Wide { const wide: Wide = keep(input); seen = 3; return wide; }
export circuit checked_helper(ok: Boolean, input: Wide): Wide { seen = 4; const wide: Wide = checked(ok, input); return wide; }
export circuit witness_before(): Wide { const wide: Wide = disclose(product_value()); seen = 5; return wide; }
export circuit witness_after(): Wide { seen = 6; const wide: Wide = disclose(product_value()); return wide; }
export circuit branch(pick: Boolean, left: Narrow, right: Narrow): Wide {
  if (disclose(pick)) { seen = 7; return keep(left); } else { seen = 8; return keep(right); }
}
export circuit deep(input: Vector<1, [[Vector<1, [[Uint<8>], Uint<8>]>], Uint<16>]>): Vector<1, [[Vector<1, [[Uint<16>], Uint<16>]>], Uint<32>]> { seen = 9; return input; }
export circuit boolean_field(input: Vector<1, [[Boolean, Uint<8>], Boolean]>): Vector<1, [[Boolean, Field], Boolean]> { seen = 10; return input; }
export circuit empty(input: Vector<0, [[Uint<8>], Uint<8>]>): Vector<0, [[Uint<16>], Uint<16>]> { seen = 11; return input; }
export circuit tuple_empty(input: Vector<1, [[[], Uint<8>], Uint<8>]>): Vector<1, [[[], Uint<16>], Uint<16>]> { seen = 12; return input; }
export circuit tuple_single(input: Vector<1, [[[Uint<8>]], Uint<8>]>): Vector<1, [[[Uint<16>]], Uint<16>]> { seen = 13; return input; }
export circuit field_identity(input: Vector<1, [[Field, Uint<8>], Uint<8>]>): Vector<1, [[Field, Uint<16>], Uint<16>]> { seen = 14; return input; }
export circuit empty_leaf(input: Vector<1, [[Vector<0, Uint<8>>, Uint<8>], Uint<8>]>): Vector<1, [[Vector<0, Uint<16>>, Uint<16>], Uint<16>]> { seen = 15; return input; }
export circuit last_child(input: Vector<1, [Uint<8>, [Uint<8>, Uint<8>]]>): Vector<1, [Uint<16>, [Uint<16>, Uint<16>]]> { seen = 16; return input; }
