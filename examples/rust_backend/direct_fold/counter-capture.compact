import CompactStandardLibrary;
export ledger stored: Field;
export ledger count: Counter;
constructor() { stored = 2; }
export circuit run(seed: Field, amount: Uint<16>, values: Vector<2, Field>): Field {
  return fold((acc: Field, item: Field): Field => {
    count.increment(disclose(amount));
    stored = disclose(acc + item);
    return stored.read();
  }, seed, values);
}
