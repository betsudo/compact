import CompactStandardLibrary;
export struct Receipt { consumed: []; emitted: []; kept: ShieldedCoinInfo; }
witness choose_coin(coin: ShieldedCoinInfo): ShieldedCoinInfo;
witness choose_recipient(recipient: Either<ZswapCoinPublicKey, ContractAddress>): Either<ZswapCoinPublicKey, ContractAddress>;
circuit register_output(coin: ShieldedCoinInfo, recipient: Either<ZswapCoinPublicKey, ContractAddress>): [] {
  return createZswapOutput(coin, recipient);
}
export circuit compose(input: QualifiedShieldedCoinInfo, coin: ShieldedCoinInfo,
                       recipient: Either<ZswapCoinPublicKey, ContractAddress>, selected: Boolean): Receipt {
  createZswapInput(input);
  if (disclose(selected)) { register_output(coin, recipient); }
  return Receipt {
    consumed: createZswapInput(input),
    emitted: createZswapOutput(choose_coin(coin), choose_recipient(recipient)),
    kept: coin
  };
}
