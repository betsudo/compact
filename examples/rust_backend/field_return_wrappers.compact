import CompactStandardLibrary;
export ledger values: Set<Field>;
export ledger count: Counter;
export ledger stored: Field;
witness choose(): Boolean;
witness observe(): Field;
constructor() { stored = 2; values.insert(5); }

export circuit inferred(selected: Boolean, value: Field): Field {
  if (disclose(selected)) { values.insert(disclose(value)); return 1; }
  else { return 0; }
}
export circuit explicit(selected: Boolean, value: Field): Field {
  if (disclose(selected)) { values.insert(disclose(value)); return 1 as Field; }
  else { return 0 as Field; }
}
export circuit nested(outer: Boolean, inner: Boolean, value: Field): Field {
  if (disclose(outer)) {
    const local = value + 1;
    if (disclose(inner)) { values.insert(disclose(local)); return 2; }
    else { count.increment(1); return 3; }
  } else { return 4; }
}
export circuit ordered(value: Field): Field {
  if (disclose(choose())) {
    values.insert(disclose(value));
    assert(observe() == 9, "observation failed after insert");
    return 1;
  } else { return 0; }
}
export circuit checked(selected: Boolean, value: Uint<16>): Field {
  if (disclose(selected)) {
    count.increment(1);
    assert(observe() == 9, "observation failed before subtraction");
    return value - 1;
  } else { return value; }
}
export circuit expression_only(value: Uint<16>): Field {
  return value as Field;
}
