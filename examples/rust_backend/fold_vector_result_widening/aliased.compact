import CompactStandardLibrary;
export type Small=Uint<8>; export type Large=Uint<16>; export type Input=Vector<2,Small>; export type Output=Vector<2,Large>;
pure circuit step(acc:Input,item:Small):Input{return [item,acc[0]];}
export pure circuit value(input:Vector<2,Small>,seed:Input):Output{return fold(step,seed,input);}
