import CompactStandardLibrary;
export ledger seen:Field;
pure circuit keep(input:Vector<2,[Vector<2,Uint<8>>,Uint<16>]>):Vector<2,[Vector<2,Uint<8>>,Uint<16>]>{return input;}
export circuit run(input:Vector<2,[Vector<2,Uint<8>>,Uint<16>]>):Vector<2,[Vector<2,Field>,Field]>{seen=1;return keep(input);}
