import CompactStandardLibrary;
export ledger seen:Field;
witness vector_value():Vector<2,[Vector<2,Uint<8>>,Uint<16>]>;
export circuit run():Vector<2,[Vector<2,Uint<16>>,Uint<32>]>{const wide:Vector<2,[Vector<2,Uint<16>>,Uint<32>]> = disclose(vector_value());seen=1;return wide;}
