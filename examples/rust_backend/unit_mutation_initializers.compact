import CompactStandardLibrary;

export ledger values: Set<Field>;
witness point(label: Field, value: Field): Field;
witness gate(label: Field, accepted: Boolean): Boolean;
witness unitGuard(label: Field, accepted: Boolean): [];

export circuit conditional(selected: Boolean, value: Field): Field {
  const inserted = disclose(selected) ? values.insert(disclose(value)) : [];
  return inserted == [] ? 1 : 0;
}

export circuit observed(selected: Boolean, value: Field): Field {
  const inserted = disclose(gate(1, selected)) ? values.insert(disclose(point(2, value))) : [];
  return inserted == [] ? disclose(point(3, 11)) : 0;
}

export circuit sequential(first: Boolean, second: Boolean, value: Field): Field {
  const inserted = disclose(gate(10, first)) ? values.insert(disclose(point(11, value))) : [];
  const next = disclose(inserted == [] ? gate(12, second) : false)
    ? values.insert(disclose(point(13, value + 1))) : [];
  return inserted == next ? disclose(point(14, 2)) : 0;
}

export circuit nested(outer: Boolean, inner: Boolean, value: Field): Field {
  if (disclose(outer)) {
    const inserted = disclose(inner) ? values.insert(disclose(value)) : [];
    return inserted == [] ? 1 : 0;
  } else { return 2; }
}

export circuit unit_result(selected: Boolean, value: Field): [] {
  const inserted = disclose(selected) ? values.insert(disclose(value)) : [];
  return inserted;
}

export circuit unused(selected: Boolean, value: Field): Field {
  const inserted = disclose(selected) ? values.insert(disclose(value)) : [];
  return disclose(point(31, 4));
}

export circuit unit_witness_comparison(left: Boolean, right: Boolean): Boolean {
  return unitGuard(21, left) == unitGuard(22, right);
}

export circuit unit_witness_inequality(left: Boolean, right: Boolean): Boolean {
  return unitGuard(21, left) != unitGuard(22, right);
}

export circuit shadowed(selected: Boolean, inner: Boolean, value: Field): Field {
  const inserted = disclose(selected) ? values.insert(disclose(value)) : [];
  if (disclose(inner)) {
    const inserted = [];
    return inserted == [] ? 2 : 0;
  } else { return inserted == [] ? 3 : 0; }
}

pure circuit requireLeft(accepted: Boolean): [] {
  assert(accepted, "left guard");
  return [];
}
pure circuit requireRight(accepted: Boolean): [] {
  assert(accepted, "right guard");
  return [];
}
export pure circuit unitEq(left: Boolean, right: Boolean): Boolean {
  return requireLeft(left) == requireRight(right);
}
export pure circuit unitNe(left: Boolean, right: Boolean): Boolean {
  return requireLeft(left) != requireRight(right);
}
export pure circuit unitCondition(left: Boolean, right: Boolean): Field {
  if (requireLeft(left) != requireRight(right)) { return 1; }
  else { return 2; }
}

// These scopes lower to statement actions, including an implicit trailing Unit.
export circuit statement_field(selected: Boolean, value: Field): Field {
  if (disclose(selected)) {
    const inserted = disclose(selected) ? values.insert(disclose(value)) : [];
  }
  return 1;
}

export circuit statement_unit(selected: Boolean, value: Field): [] {
  if (disclose(selected)) {
    const inserted = disclose(selected) ? values.insert(disclose(value)) : [];
  }
}

export circuit trailing_conditional(first: Boolean, second: Boolean, value: Field): [] {
  const inserted = disclose(first) ? values.insert(disclose(value)) : [];
  if (disclose(second)) { values.insert(disclose(value + 1)); }
}

export circuit trailing_unconditional(selected: Boolean, value: Field): [] {
  const inserted = disclose(selected) ? values.insert(disclose(value)) : [];
  values.insert(disclose(value + 1));
}

export circuit statement_observed(selected: Boolean, value: Field): Field {
  if (disclose(gate(1, selected))) {
    const inserted = disclose(selected) ? values.insert(disclose(point(2, value))) : [];
    const next = inserted == [] ? values.insert(disclose(point(3, value + 1))) : [];
  }
  return disclose(point(10, 4));
}

export circuit statement_shadowed(outer: Boolean, inner: Boolean, value: Field): Field {
  const inserted = disclose(outer) ? values.insert(disclose(value)) : [];
  if (disclose(inner)) {
    const inserted = disclose(inner) ? values.insert(disclose(value + 1)) : [];
    if (inserted == []) { values.insert(disclose(value + 2)); }
  }
  return values.size() as Field;
}
