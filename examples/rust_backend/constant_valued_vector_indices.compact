import CompactStandardLibrary;

export ledger stored: Field;
export struct OwnedSelection { first: Opaque<"string">; repeated: Opaque<"string">; original: Vector<2, Opaque<"string">>; }
witness values(): Vector<2, Field>;

export pure circuit first(items: Vector<2, Field>): Field { const i = 1; const index = i * 0; return items[index]; }
export pure circuit last(items: Vector<2, Field>): Field { const index = 1; const one: Uint<8> = 1; return items[(index * 2) - one]; }
export pure circuit singleton(items: Vector<1, Field>): Field { const index = 0; return items[index]; }

export pure circuit first_text(items: Vector<2, Opaque<"string">>): Opaque<"string"> {
  const index = 1;
  return items[(index + 1) - 2];
}
pure circuit texts(items: Vector<2, Opaque<"string">>): Vector<2, Opaque<"string">> {
  return items;
}
export pure circuit temporary_text(items: Vector<2, Opaque<"string">>): Opaque<"string"> {
  const index = 0;
  return texts(items)[index + 1];
}

export circuit choose(items: Vector<2, Field>, select_first: Boolean): Field {
  const index = 1;
  const one: Uint<8> = 1;
  const selected = select_first ? items[index - (one * 1)] : items[(index * 2) - one];
  stored = disclose(selected);
  return stored;
}
export circuit owned(items: Vector<2, Opaque<"string">>): OwnedSelection {
  const i = 1;
  const first = i * 0;
  const repeated = first + 0;
  const a = items[first];
  const b = items[repeated];
  stored = 1;
  return OwnedSelection { first: a, repeated: b, original: items };
}
export circuit witnessed(select_first: Boolean): Field {
  const items = values();
  const index = 1;
  const one: Uint<8> = 1;
  const selected = select_first ? items[index - (one * 1)] : items[(index * 2) - one];
  stored = disclose(selected);
  return stored;
}
export circuit temporary(): Field {
  const index = 2;
  stored = disclose(values()[index - 1]);
  return stored;
}
export circuit conditional(active: Boolean): Field {
  const index = 0;
  if (disclose(active)) { stored = disclose(values()[index]); }
  else { stored = 0; }
  return stored;
}
