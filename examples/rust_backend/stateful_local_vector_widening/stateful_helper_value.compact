import CompactStandardLibrary;
export ledger seen:Field;
circuit change(input:Vector<2,Uint<8>>):Vector<2,Uint<8>>{assert(seen==1,"caller write absent");seen=2;return [input[1],input[0]];}
export circuit run(input:Vector<2,Uint<8>>):Vector<2,Uint<16>>{seen=1;const wide:Vector<2,Uint<16>> = change(input);seen=3;return wide;}
