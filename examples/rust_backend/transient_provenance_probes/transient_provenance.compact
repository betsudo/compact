import CompactStandardLibrary;

witness supplied(value: Field): Field;

export circuit direct(value: Field): Bytes<32> {
  return persistentHash<Field>(transientHash<Field>(value));
}

export circuit committed(value: Field, opening: Bytes<32>): Bytes<32> {
  const digest = transientCommit<Field>(value, value);
  return persistentCommit<Field>(digest, opening);
}

export circuit mixed(value: Field, other: Field): Bytes<32> {
  const digest = transientHash<Field>(value);
  const combined = digest + other;
  return persistentHash<Field>(combined);
}

export circuit converted(value: Field): Bytes<32> {
  const digest = transientHash<Field>(value);
  const bytes = upgradeFromTransient(digest);
  return persistentHash<Bytes<32>>(bytes);
}

export circuit opening(value: Field): Bytes<32> {
  const bytes = upgradeFromTransient(transientHash<Field>(value));
  return persistentCommit<Field>(value, bytes);
}

export circuit ordinary(value: Field): Bytes<32> {
  return persistentHash<Field>(value);
}

export circuit ordinary_witness(value: Field): Bytes<32> {
  return persistentHash<Field>(disclose(supplied(value)));
}

export circuit transient_only(value: Field): Field {
  return transientHash<Field>(value);
}
