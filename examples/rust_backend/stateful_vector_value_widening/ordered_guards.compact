import CompactStandardLibrary;
export ledger seen:Field;
pure circuit keep(input:Vector<2,Uint<8>>):Vector<2,Uint<8>>{return input;}
export circuit run(a:Boolean,b:Boolean,input:Vector<2,Uint<8>>):Vector<2,Uint<16>>{assert(a,"first denied");seen=1;assert(b,"second denied");return keep(input);}
