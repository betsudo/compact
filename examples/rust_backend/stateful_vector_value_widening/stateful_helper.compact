import CompactStandardLibrary;
export ledger seen:Field;
circuit change(input:Vector<2,Uint<8>>):Vector<2,Uint<8>>{seen=1;return input;}
export circuit run(input:Vector<2,Uint<8>>):Vector<2,Uint<16>>{return change(input);}
