import CompactStandardLibrary;
export ledger seen:Field;
pure circuit keep(ok:Boolean,input:Vector<0,Uint<8>>):Vector<0,Uint<8>>{assert(ok,"empty denied");return input;}
export circuit run(ok:Boolean,input:Vector<0,Uint<8>>):Vector<0,Uint<16>>{seen=1;return keep(ok,input);}
