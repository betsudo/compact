import CompactStandardLibrary;
export ledger seen:Field;
export ledger saved:Vector<2,Uint<8>>;
constructor(input:Vector<2,Uint<8>>){saved=disclose(input);}
export circuit run():Vector<2,Uint<16>>{return saved;}

