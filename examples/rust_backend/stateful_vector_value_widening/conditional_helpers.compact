import CompactStandardLibrary;
export ledger seen:Field;
pure circuit keep(input:Vector<2,Uint<8>>):Vector<2,Uint<8>>{return input;}
pure circuit flip(input:Vector<2,Uint<8>>):Vector<2,Uint<8>>{return [input[1],input[0]];}
constructor(initialSeen:Field){seen=disclose(initialSeen);}
export circuit run(input:Vector<2,Uint<8>>):Vector<2,Uint<16>>{if(seen==0){seen=1;return keep(input);}else{seen=3;return flip(input);}}
