import CompactStandardLibrary;

export ledger table: Map<Field, Field>;
export ledger outer: Map<Field, Map<Field, Field>>;
export struct Counts { before: Uint<64>; after: Uint<64>; outer: Uint<64>; }
witness offset(): Uint<64>;

constructor() { table.insert(1, 11); }

export circuit direct(): Uint<64> { return table.size(); }
export circuit snapshot(): Counts {
  return Counts { before: table.size(), after: table.size(), outer: outer.size() };
}
export circuit empty(): Boolean { return table.size() == 0; }
export circuit plus_one(): Uint<64> { return (table.size() + 1) as Uint<64>; }
export circuit choose(active: Boolean): Uint<64> {
  return disclose(active) ? table.size() : 7 as Uint<64>;
}
export circuit put(key: Field, value: Field): Counts {
  const before = table.size();
  table.insert(disclose(key), disclose(value));
  return Counts { before: before, after: table.size(), outer: outer.size() };
}
export circuit ordered(): Uint<64> {
  const count = table.size();
  return (count + disclose(offset())) as Uint<64>;
}
export circuit witnessed(active: Boolean): Uint<64> {
  if (disclose(active)) {
    table.insert(disclose(offset()) as Field, 99);
  }
  return table.size();
}
