import CompactStandardLibrary;
type SmallVector = Vector<2, Uint<8>>;
type WideVector = Vector<2, Uint<16>>;
export ledger stored: Field;
constructor(input: Vector<2, SmallVector>, right: WideVector) {
  stored = 99;
  for (const item of input) {
    if (disclose(item == right)) { stored = 7; } else { stored = 11; }
  }
}
export circuit read(): Field { return stored.read(); }
export circuit advance(delta: Field): Field {
  stored = disclose(stored.read() + delta);
  return stored.read();
}
export circuit advance_other(delta: Field): Field {
  stored = disclose(stored.read() + delta + 1);
  return stored.read();
}
