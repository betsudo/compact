import CompactStandardLibrary;
export ledger cell: Field;
witness echo(flag: Boolean): Boolean;
export circuit choose(selected: Boolean, flag: Boolean, value: Field): Field {
  if (disclose(selected)) {
    assert(disclose(echo(flag)), "selected denied");
    cell = disclose(value);
  } else {
    assert(disclose(flag), "inactive denied");
    cell = disclose(value);
  }
  return cell.read();
}
export circuit LedgerView(flag: Boolean, value: Field): Field {
  assert(disclose(echo(flag)), "view denied");
  cell = disclose(value);
  return cell.read();
}
export circuit TryWitnesses(flag: Boolean, value: Field): Field {
  assert(disclose(echo(flag)), "trait denied");
  cell = disclose(value);
  return cell.read();
}
export circuit functional(flag: Boolean, value: Field): Field {
  assert(disclose(echo(flag)), "module denied");
  cell = disclose(value);
  return cell.read();
}
