import CompactStandardLibrary;
export struct Receipt { initialHead: Maybe<Field>; initialEmpty: Boolean; twoHead: Maybe<Field>; twoLength: Uint<64>; oneHead: Maybe<Field>; oneLength: Uint<64>; poppedHead: Maybe<Field>; poppedLength: Uint<64>; poppedEmpty: Boolean; resetHead: Maybe<Field>; resetEmpty: Boolean; ownedHead: Maybe<Opaque<"string">>; ownedEmpty: Boolean; }
export ledger padding0: Field;
export ledger padding1: Field;
export ledger padding2: Field;
export ledger padding3: Field;
export ledger padding4: Field;
export ledger padding5: Field;
export ledger padding6: Field;
export ledger padding7: Field;
export ledger padding8: Field;
export ledger padding9: Field;
export ledger padding10: Field;
export ledger padding11: Field;
export ledger padding12: Field;
export ledger padding13: Field;
export ledger padding14: Field;
export ledger padding15: Field;
export ledger stored: Field;
export ledger items: List<Field>;
export ledger labels: List<Opaque<"string">>;
witness nextValue(value: Field): Field;
constructor() { stored = 3; }
// Ordinary private circuits avoid the known direct nested ADT lowering gaps.
circuit push(value: Field): [] { items.pushFront(disclose(value)); }
circuit pop(): [] { items.popFront(); }
circuit clear(): [] { items.resetToDefault(); }
circuit count(): Uint<64> { return items.length(); }
circuit first(): Maybe<Field> { return items.head(); }
circuit empty(): Boolean { return items.isEmpty(); }
circuit pushLabel(value: Opaque<"string">): [] { labels.pushFront(disclose(value)); }
circuit popLabel(): [] { labels.popFront(); }
circuit firstLabel(): Maybe<Opaque<"string">> { return labels.head(); }
circuit emptyLabels(): Boolean { return labels.isEmpty(); }
export circuit exercise(value: Field, label: Opaque<"string">): Receipt {
  const initialHead = first();
  const initialEmpty = empty();
  const next = nextValue(value);
  stored = disclose(next);
  push(next);
  push(next + 1);
  const twoHead = first();
  const twoLength = count();
  pop();
  const oneHead = first();
  const oneLength = count();
  pop();
  const poppedHead = first();
  const poppedLength = count();
  const poppedEmpty = empty();
  push(9 as Field);
  clear();
  const resetHead = first();
  const resetEmpty = empty();
  pushLabel(label);
  const ownedHead = firstLabel();
  popLabel();
  const ownedEmpty = emptyLabels();
  return Receipt { initialHead: initialHead, initialEmpty: initialEmpty, twoHead: twoHead, twoLength: twoLength, oneHead: oneHead, oneLength: oneLength, poppedHead: poppedHead, poppedLength: poppedLength, poppedEmpty: poppedEmpty, resetHead: resetHead, resetEmpty: resetEmpty, ownedHead: ownedHead, ownedEmpty: ownedEmpty };
}
export circuit guarded(selected: Boolean, permit: Boolean, after: Boolean): Field {
  if (disclose(selected)) {
    assert(disclose(permit), "list denied");
    const next = nextValue(11 as Field);
    push(next);
    stored = disclose(next);
    assert(disclose(after), "list after denied");
    pop();
    stored = disclose(nextValue(stored.read()));
  } else { stored = 9; }
  return stored.read();
}
// Official Ledger8 empty pop succeeds and leaves the List leaf Null, not its initial empty Array.
export circuit emptyPop(): [] { items.popFront(); }
