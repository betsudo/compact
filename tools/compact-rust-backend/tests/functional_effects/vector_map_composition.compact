import CompactStandardLibrary;
export struct Owned { value: Field; text: Opaque<"string">; bytes: Opaque<"Uint8Array">; }
export struct OwnedReceipt { mapped: Vector<3, Owned>; original: Vector<3, Field>; text: Opaque<"string">; }
export struct CheckedReceipt { mapped: Vector<3, Uint<8>>; original: Vector<3, Uint<16>>; }
export ledger stored: Field;
witness marker(value: Field): Field;
pure circuit bump(value: Field): Field { return value + 1; }
pure circuit add(acc: Field, value: Field): Field { return acc + value; }
pure circuit folded(value: Field): Field { return fold(add, value, [1 as Field, 2]); }
export circuit owned(selected: Boolean, values: Vector<3, Field>, text: Opaque<"string">, bytes: Opaque<"Uint8Array">): OwnedReceipt {
  const mapped = map((x: Field): Owned => Owned { value: selected ? bump(x) : folded(x), text: text, bytes: bytes }, values);
  stored = 1;
  return OwnedReceipt { mapped: mapped, original: values, text: text };
}
export circuit empty(values: Vector<0, Uint<16>>): Vector<0, Uint<8>> {
  const mapped = map((x: Uint<16>): Uint<8> => x as Uint<8>, values);
  stored = disclose(marker(0 as Field));
  return disclose(mapped);
}
export circuit single(values: Vector<1, Uint<16>>): Vector<1, Uint<8>> {
  const mapped = map((x: Uint<16>): Uint<8> => x as Uint<8>, values);
  stored = disclose(marker(1 as Field));
  return disclose(mapped);
}
export circuit checked(selected: Boolean, values: Vector<3, Uint<16>>): CheckedReceipt {
  const mapped = map((x: Uint<16>): Uint<8> => selected ? x as Uint<8> : 7 as Uint<8>, values);
  stored = disclose(marker(3 as Field));
  return CheckedReceipt { mapped: disclose(mapped), original: disclose(values) };
}
export circuit prefixed(selected: Boolean, values: Vector<3, Uint<16>>): CheckedReceipt {
  stored = disclose(marker(99 as Field));
  const mapped = map((x: Uint<16>): Uint<8> => selected ? x as Uint<8> : 7 as Uint<8>, values);
  stored = disclose(marker(3 as Field));
  return CheckedReceipt { mapped: disclose(mapped), original: disclose(values) };
}
export circuit nested(selected: Boolean, permit: Boolean, values: Vector<2, Field>): Vector<2, Vector<2, Field>> {
  const mapped = selected ? map((x: Field): Vector<2, Field> => {
    assert(permit, "map body denied");
    const inner: Vector<2, Field> = [x, x + 1];
    return map((y: Field): Field => bump(y), inner);
  }, values) : [[7 as Field, 7], [7 as Field, 7]];
  stored = disclose(marker(4 as Field));
  return disclose(mapped);
}
