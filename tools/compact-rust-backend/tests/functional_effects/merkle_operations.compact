import CompactStandardLibrary;
export struct Snapshot { plainFull: Boolean; historicFull: Boolean; plainKnown: Boolean; historicKnown: Boolean; }
export ledger padding0: Field;
export ledger padding1: Field;
export ledger padding2: Field;
export ledger padding3: Field;
export ledger padding4: Field;
export ledger padding5: Field;
export ledger padding6: Field;
export ledger padding7: Field;
export ledger padding8: Field;
export ledger padding9: Field;
export ledger padding10: Field;
export ledger padding11: Field;
export ledger padding12: Field;
export ledger padding13: Field;
export ledger padding14: Field;
export ledger padding15: Field;
export ledger plain: MerkleTree<3, Uint<8>>;
export ledger historic: HistoricMerkleTree<3, Uint<8>>;
circuit plainFull(): Boolean { return plain.isFull(); }
circuit historicFull(): Boolean { return historic.isFull(); }
circuit plainKnown(root: MerkleTreeDigest): Boolean { return plain.checkRoot(disclose(root)); }
circuit historicKnown(root: MerkleTreeDigest): Boolean { return historic.checkRoot(disclose(root)); }
export circuit observe(root: MerkleTreeDigest): Snapshot {
  return Snapshot { plainFull: plainFull(), historicFull: historicFull(), plainKnown: plainKnown(root), historicKnown: historicKnown(root) };
}
export circuit append(value: Uint<8>): [] { plain.insert(disclose(value)); historic.insert(disclose(value)); }
export circuit place(value: Uint<8>, index: Uint<64>): [] { plain.insertIndex(disclose(value), disclose(index)); historic.insertIndex(disclose(value), disclose(index)); }
export circuit appendHash(hash: Bytes<32>): [] { plain.insertHash(disclose(hash)); historic.insertHash(disclose(hash)); }
export circuit placeHash(hash: Bytes<32>, index: Uint<64>): [] { plain.insertHashIndex(disclose(hash), disclose(index)); historic.insertHashIndex(disclose(hash), disclose(index)); }
export circuit placeDefault(index: Uint<64>): [] { plain.insertIndexDefault(disclose(index)); historic.insertIndexDefault(disclose(index)); }
export circuit forget(): [] { historic.resetHistory(); }
export circuit reset(): [] { plain.resetToDefault(); historic.resetToDefault(); }
