import CompactStandardLibrary;
export ledger cell: Field;
export circuit write(a$b: Field, a_b: Field, runtime: Field): Field {
  cell = disclose(a$b);
  cell = disclose(a_b);
  return runtime;
}
export circuit many(a: Boolean, b: Boolean, c: Boolean, d: Boolean,
                    e: Boolean, f: Boolean, g: Boolean, h: Boolean): Boolean {
  assert(disclose(a), "a");
  assert(disclose(b), "b");
  assert(disclose(c), "c");
  assert(disclose(d), "d");
  assert(disclose(e), "e");
  assert(disclose(f), "f");
  assert(disclose(g), "g");
  assert(disclose(h), "h");
  cell = 1;
  return disclose(h);
}
