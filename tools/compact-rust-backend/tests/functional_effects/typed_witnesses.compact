import CompactStandardLibrary;
export struct Packet { value: Field; bytes: Bytes<3>; }
export ledger fieldCell: Field;
export ledger byteCell: Bytes<3>;
export ledger packetCell: Packet;
witness gate(allow: Boolean): Boolean;
witness zeroUnit(): [];
witness zeroField(): Field;
witness oneUnit(value: []): Field;
witness first(value: Field): Field;
witness second(value: Field): Field;
witness byteEcho(value: Bytes<3>): Bytes<3>;
witness mixed(value: Field, bytes: Bytes<3>): Packet;
witness product(packet: Packet): Packet;
witness tupleMixed(pair: [Field, Bytes<3>]): Packet;
export circuit typed(selected: Boolean, allow: Boolean, value: Field,
                     bytes: Bytes<3>, packet: Packet, pair: [Field, Bytes<3>]): Field {
  if (disclose(selected)) {
    assert(disclose(gate(allow)), "typed denied");
    zeroUnit();
    fieldCell = disclose(zeroField());
    fieldCell = disclose(oneUnit(default<[]>));
    fieldCell = disclose(first(value));
    fieldCell = disclose(second(fieldCell.read()));
    byteCell = disclose(byteEcho(bytes));
    packetCell = disclose(mixed(value, bytes));
    packetCell = disclose(product(packet));
    packetCell = disclose(tupleMixed(pair));
  } else {
    fieldCell = disclose(value);
  }
  return fieldCell.read();
}
