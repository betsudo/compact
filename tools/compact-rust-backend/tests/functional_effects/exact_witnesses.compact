import CompactStandardLibrary;
export struct Payload { text: Opaque<"string">; bytes: Opaque<"Uint8Array">; }
export struct Envelope { payload: Payload; marker: Field; }
export ledger fieldCell: Field;
witness offset(value: Field, text: Opaque<"string">): Field;
witness observeText(value: Opaque<"string">): Field;
witness exactText(value: Opaque<"string">): Opaque<"string">;
witness exactBytes(value: Opaque<"Uint8Array">): Opaque<"Uint8Array">;
witness exactEnvelope(value: Envelope): Envelope;
export circuit exact(selected: Boolean, allow: Boolean, proceed: Boolean, value: Field,
                     text: Opaque<"string">, bytes: Opaque<"Uint8Array">,
                     envelope: Envelope): Field {
  if (disclose(selected)) {
    assert(disclose(allow), "exact denied");
    fieldCell = disclose(offset(value, text));
    const returnedText = exactText(text);
    assert(disclose(proceed), "after exact denied");
    fieldCell = disclose(observeText(returnedText));
    const returnedBytes = exactBytes(bytes);
    const returnedEnvelope = exactEnvelope(envelope);
  } else {
    fieldCell = disclose(value);
  }
  return fieldCell.read();
}
