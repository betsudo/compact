import CompactStandardLibrary;
export enum Choice { first, second, third }
export ledger bytes: Bytes<3>;
export ledger small: Uint<16>;
export ledger wide: Uint<128>;
export ledger choice: Choice;
constructor() {
  bytes = "xyz"; small = 9; wide = 9; choice = Choice.third;
}
export circuit choose(literals: Boolean): Boolean {
  if (disclose(literals)) {
    bytes = "abc";
    small = 257;
    wide = 18446744073709551616;
    choice = Choice.second;
  } else {
    bytes = default<Bytes<3>>;
    small = default<Uint<16>>;
    wide = default<Uint<128>>;
    choice = default<Choice>;
  }
  assert((small == 257) == disclose(literals), "small literal/default");
  assert((wide == 18446744073709551616) == disclose(literals), "wide literal/default");
  assert((choice == Choice.second) == disclose(literals), "enum literal/default");
  return bytes == "abc";
}
