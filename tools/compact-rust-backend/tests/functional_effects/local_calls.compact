import CompactStandardLibrary;
export ledger stored: Field;
witness nextValue(seed: Field): Field;
witness finish(value: Field): Field;
constructor() { stored = 2; }
pure circuit combine(first: Field, second: Field): Field { return first * 2 + second; }
pure circuit sum(acc: Field, value: Field): Field { return acc + value; }
pure circuit total(seed: Field): Field {
  const values: Vector<2, Field> = [2, 3];
  return fold(sum, seed, values);
}
circuit passUnit(value: []): [] { return value; }
circuit update(seed: Field, permit: Boolean): Field {
  const before = stored.read();
  const value = nextValue(seed + before);
  stored = disclose(value);
  assert(disclose(permit), "local call denied");
  return stored.read();
}
export circuit run(selected: Boolean, seed: Field, permit: Boolean): Field {
  passUnit(default<[]>);
  const first = update(seed, true);
  if (disclose(selected)) { stored = disclose(update(seed + 2, permit)); }
  const after = finish(stored.read());
  return disclose(combine(first, after));
}
export circuit folded(seed: Field): Field {
  stored = disclose(total(seed));
  return stored.read();
}
