import CompactStandardLibrary;
export struct Owned { text: Opaque<"string">; bytes: Opaque<"Uint8Array">; }
export struct Receipt { found: Field; beforeSize: Uint<64>; beforeEmpty: Boolean; removed: Boolean; remainingSize: Uint<64>; defaultValue: Field; resetEmpty: Boolean; resetSize: Uint<64>; owned: Owned; }
export ledger padding0: Field;
export ledger padding1: Field;
export ledger padding2: Field;
export ledger padding3: Field;
export ledger padding4: Field;
export ledger padding5: Field;
export ledger padding6: Field;
export ledger padding7: Field;
export ledger padding8: Field;
export ledger padding9: Field;
export ledger padding10: Field;
export ledger padding11: Field;
export ledger padding12: Field;
export ledger padding13: Field;
export ledger padding14: Field;
export ledger padding15: Field;
export ledger stored: Field;
export ledger table: Map<Boolean, Field>;
export ledger ownedTable: Map<Field, Owned>;
witness nextValue(value: Field): Field;
constructor() { stored = 3; table.insert(true, 11 as Field); }
// Direct nested mutation/size frontend lowering remains a separate gap.
// Ordinary private circuits preserve each operation through generic local calls.
circuit put(key: Boolean, value: Field): [] { table.insert(disclose(key), disclose(value)); }
circuit putDefault(key: Boolean): [] { table.insertDefault(disclose(key)); }
circuit remove(key: Boolean): [] { table.remove(disclose(key)); }
circuit reset(): [] { table.resetToDefault(); }
circuit count(): Uint<64> { return table.size(); }
circuit putOwned(value: Owned): [] { ownedTable.insert(7 as Field, disclose(value)); }
circuit removeOwned(): [] { ownedTable.remove(7 as Field); }
export circuit exercise(value: Field, owned: Owned): Receipt {
  const next = nextValue(value);
  stored = disclose(next);
  put(true, next);
  const found = table.lookup(true);
  putDefault(false);
  const beforeSize = count();
  const beforeEmpty = table.isEmpty();
  remove(true);
  const removed = table.member(true);
  const remainingSize = count();
  const defaultValue = table.lookup(false);
  reset();
  const resetEmpty = table.isEmpty();
  const resetSize = count();
  putOwned(owned);
  const saved = ownedTable.lookup(7 as Field);
  removeOwned();
  return Receipt { found: found, beforeSize: beforeSize, beforeEmpty: beforeEmpty, removed: removed, remainingSize: remainingSize, defaultValue: defaultValue, resetEmpty: resetEmpty, resetSize: resetSize, owned: saved };
}
export circuit guarded(selected: Boolean, permit: Boolean, key: Boolean): Field {
  if (disclose(selected)) {
    assert(disclose(permit), "map denied");
    const found = table.lookup(disclose(key));
    stored = disclose(nextValue(found));
  } else { stored = 9; }
  return stored.read();
}
