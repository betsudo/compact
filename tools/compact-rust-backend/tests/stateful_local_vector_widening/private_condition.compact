import CompactStandardLibrary;
export ledger seen:Field;
pure circuit keep(input:Vector<2,Uint<8>>):Vector<2,Uint<8>>{return input;}
export circuit run(ok:Boolean,input:Vector<2,Uint<8>>):Vector<2,Uint<16>>{if(ok){seen=1;const wide:Vector<2,Uint<16>> = keep(input);return wide;}else{seen=2;const wide:Vector<2,Uint<16>> = keep(input);return wide;}}
