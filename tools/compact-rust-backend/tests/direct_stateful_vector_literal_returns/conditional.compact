import CompactStandardLibrary;
export ledger seen:Field;
export circuit run(ok:Boolean,input:Vector<2,Uint<8>>):Vector<2,Uint<16>>{if(ok){seen=1;return [input[1],input[0]];}else{seen=2;return [input[0],input[1]];}}
