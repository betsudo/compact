import CompactStandardLibrary;
export ledger stored: Field;
witness values(): Vector<2, Field>;

export circuit guarded(active: Boolean): Field {
  if (disclose(active)) {
    const a = 1;
    const b = 2;
    stored = disclose(values()[(a - b) * 0]);
  } else { stored = 0; }
  return stored;
}

export circuit guarded_unknown(active: Boolean): Field {
  if (disclose(active)) {
    const a = 1;
    const b = 2;
    const bad = a - b;
    stored = disclose(values()[(bad - 1) * 0]);
  } else { stored = 0; }
  return stored;
}
