import CompactStandardLibrary;

pure circuit add_byte(acc: Uint<8>, item: Uint<8>): Uint<8> {
    return (acc + item) as Uint<8>;
}

export pure circuit bytes_fold_named(): Uint<8> {
    const bytes = Bytes[1, 2, 3];
    return fold(add_byte, 0 as Uint<8>, bytes);
}
