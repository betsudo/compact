import CompactStandardLibrary;

witness initial_operand(): Field;
witness empty_operand(): Bytes<0>;
witness unreachable_reducer(): Field;

export circuit zero_operand_order(): Field {
    fold((acc: Field, b: Uint<8>): Field => unreachable_reducer(),
         initial_operand(), empty_operand());
    return 0 as Field;
}
