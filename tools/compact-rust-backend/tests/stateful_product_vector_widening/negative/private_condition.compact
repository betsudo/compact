import CompactStandardLibrary;
export ledger seen:Field;
export circuit run(ok:Boolean,input:Vector<2,[Uint<8>,Uint<16>]>):Vector<2,[Uint<16>,Uint<32>]>{if(ok){seen=1;return input;}else{seen=2;return input;}}
