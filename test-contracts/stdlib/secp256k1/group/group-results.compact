import CompactStandardLibrary;

export ledger result: Secp256k1Point;

export circuit writeGenerator(scalar: Secp256k1Scalar): [] {
  result = disclose(ecMulGenerator(scalar));
}

export circuit writeMul(point: Secp256k1Point, scalar: Secp256k1Scalar): [] {
  result = disclose(ecMul(point, scalar));
}

export circuit writeAdd(left: Secp256k1Point, right: Secp256k1Point): [] {
  result = disclose(ecAdd(left, right));
}

export circuit generator(scalar: Secp256k1Scalar): Secp256k1Point {
  return ecMulGenerator(scalar);
}

export circuit multiply(point: Secp256k1Point, scalar: Secp256k1Scalar): Secp256k1Point {
  return ecMul(point, scalar);
}

export circuit add(left: Secp256k1Point, right: Secp256k1Point): Secp256k1Point {
  return ecAdd(left, right);
}

export circuit jubjubZero(): JubjubPoint {
  return ecMulGenerator(0 as Field);
}
