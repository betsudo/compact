import CompactStandardLibrary;

export ledger x: Secp256k1Base;
export ledger y: Secp256k1Base;
export ledger seen: Boolean;

export circuit writeX(pt: Secp256k1Point, enabled: Boolean): [] {
  x = disclose(enabled ? secp256k1PointX(pt) : default<Secp256k1Base>);
}

export circuit writeY(pt: Secp256k1Point, enabled: Boolean): [] {
  y = disclose(enabled ? secp256k1PointY(pt) : default<Secp256k1Base>);
}

export circuit discardX(pt: Secp256k1Point): [] {
  secp256k1PointX(pt);
  seen = true;
}
