import CompactStandardLibrary;

export ledger wantProof: Boolean;

pure circuit neg(value: Boolean): Boolean {
  return !value;
}

pure circuit inv(value: Boolean): Boolean {
  return value;
}

export circuit negBase(value: Secp256k1Base): Secp256k1Base {
  wantProof = true;
  return neg(value);
}

export circuit negScalar(value: Secp256k1Scalar): Secp256k1Scalar {
  wantProof = true;
  return neg(value);
}

export circuit guardedInvBase(enabled: Boolean, value: Secp256k1Base): Secp256k1Base {
  wantProof = true;
  return enabled ? inv(value) : value;
}

export circuit guardedInvScalar(enabled: Boolean, value: Secp256k1Scalar): Secp256k1Scalar {
  wantProof = true;
  return enabled ? inv(value) : value;
}

export circuit discardInvBase(value: Secp256k1Base): Boolean {
  inv(value);
  wantProof = true;
  return true;
}

export circuit discardInvScalar(value: Secp256k1Scalar): Boolean {
  inv(value);
  wantProof = true;
  return true;
}

export pure circuit pureDiscardInvScalar(value: Secp256k1Scalar): Boolean {
  inv(value);
  return true;
}

export circuit localOverloads(value: Boolean): [Boolean, Boolean] {
  wantProof = true;
  return [neg(value), inv(value)];
}
