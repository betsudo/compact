import CompactStandardLibrary;
export ledger k1b: Secp256k1Base;
export ledger k1s: Secp256k1Scalar;
export circuit castK1(b: Boolean, x: Secp256k1Base, y: Secp256k1Scalar): [] {
  k1b = disclose(b ? x : (452312848583266388373324160190187140051835877600158453279131187530910662661 as Field as Bytes<32>) as Secp256k1Base);
  k1s = disclose(b ? y : (452312848583266388373324160190187140051835877600158453279131187530910662661 as Field as Bytes<32>) as Secp256k1Scalar);
}
export circuit castZero(): [] {
  k1b = disclose((0 as Field as Bytes<32>) as Secp256k1Base);
  k1s = disclose((0 as Field as Bytes<32>) as Secp256k1Scalar);
}
