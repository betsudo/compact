import CompactStandardLibrary;

export ledger baseCell: Secp256k1Base;
export ledger scalarCell: Secp256k1Scalar;
export ledger bytesCell: Bytes<32>;

export circuit decodeBase(value: Bytes<32>): Secp256k1Base {
  baseCell = disclose(value as Secp256k1Base);
  return baseCell;
}

export circuit decodeScalar(value: Bytes<32>): Secp256k1Scalar {
  scalarCell = disclose(value as Secp256k1Scalar);
  return scalarCell;
}

export circuit encodeBase(value: Secp256k1Base): Bytes<32> {
  bytesCell = disclose(value as Bytes<32>);
  return bytesCell;
}

export circuit encodeScalar(value: Secp256k1Scalar): Bytes<32> {
  bytesCell = disclose(value as Bytes<32>);
  return bytesCell;
}

export circuit guardedDecode(enabled: Boolean, value: Bytes<32>): [Secp256k1Base, Secp256k1Scalar] {
  if (disclose(enabled)) {
    baseCell = disclose(value as Secp256k1Base);
    scalarCell = disclose(value as Secp256k1Scalar);
  }
  return [baseCell, scalarCell];
}
