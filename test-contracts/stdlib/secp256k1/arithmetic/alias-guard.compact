import CompactStandardLibrary;
export type Base = Secp256k1Base;
export new type ScalarValue = Secp256k1Scalar;
export ledger result: Base;
export circuit guarded(flag: Boolean, left: Base, right: Base): Base {
  if (disclose(flag)) {
    result = disclose((left + right) + (left + right));
  }
  return result;
}
export pure circuit nominal(left: ScalarValue, right: ScalarValue): ScalarValue {
  return left - right;
}
