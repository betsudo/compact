import CompactStandardLibrary;

export ledger saved: JubjubScalar;

export circuit store(value: JubjubScalar): Field {
  saved = disclose(value);
  return saved as Field;
}

export circuit clear(): JubjubScalar {
  saved = default<JubjubScalar>;
  return saved;
}

export pure circuit reduce(value: Field): JubjubScalar {
  return value as JubjubScalar;
}

export pure circuit reduceUint(value: Uint<64>): JubjubScalar {
  return value as JubjubScalar;
}

export pure circuit point(value: JubjubScalar): JubjubPoint {
  return ecMulGenerator(value);
}

export pure circuit mul(value: JubjubScalar, point: JubjubPoint): JubjubPoint {
  return ecMul(point, value);
}
