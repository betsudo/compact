import CompactStandardLibrary;

export ledger base: Curve25519Base;
export ledger scalar: Curve25519Scalar;
export ledger digest: Bytes<32>;

export circuit arithmetic(a: Curve25519Base, b: Curve25519Scalar): [Curve25519Base, Curve25519Scalar] {
  base = disclose((a + a) * inv(a) - neg(a));
  scalar = disclose((b + b) * inv(b) - neg(b));
  return [base, scalar];
}
export circuit casts(v: Bytes<32>): [Bytes<32>, Bytes<32>] {
  base = disclose(v as Curve25519Base);
  scalar = disclose(v as Curve25519Scalar);
  return [base as Bytes<32>, scalar as Bytes<32>];
}
export circuit hashScalar(v: Curve25519Scalar): Bytes<32> {
  digest = disclose(persistentHash<Curve25519Scalar>(v));
  return digest;
}
