import CompactStandardLibrary;

export ledger base: Curve25519Base;
export ledger scalar: Curve25519Scalar;

export circuit store(baseValue: Curve25519Base, scalarValue: Curve25519Scalar): [] {
    base = disclose(baseValue);
    scalar = disclose(scalarValue);
}

export circuit reset(): [Curve25519Base, Curve25519Scalar] {
    base = default<Curve25519Base>;
    scalar = default<Curve25519Scalar>;
    return [base, scalar];
}
