import CompactStandardLibrary;
ledger F1: Curve25519Point;
ledger F2: Secp256k1Point;
ledger F3: Secp256r1Point;
export circuit foo1(bv: Bytes<64>): Curve25519Point {
  F1 = deserialize<Curve25519Point, 64>(disclose(bv));
  return F1;
}
