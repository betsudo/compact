import CompactStandardLibrary;

export ledger baseCell: Secp256r1Base;
export ledger scalarCell: Secp256r1Scalar;

export circuit scalarRoundtrip(value: Secp256r1Scalar): Secp256r1Scalar {
  scalarCell = disclose(value);
  return scalarCell;
}

export circuit resetFields(): [Secp256r1Base, Secp256r1Scalar] {
  baseCell = default<Secp256r1Base>;
  scalarCell = default<Secp256r1Scalar>;
  return [baseCell, scalarCell];
}
