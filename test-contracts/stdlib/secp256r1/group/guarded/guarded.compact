import CompactStandardLibrary;

export ledger pt: Secp256r1Point;

export circuit guardedAdd(enabled: Boolean, a: Secp256r1Point, b: Secp256r1Point): Secp256r1Point {
  const result = enabled ? ecAdd(a, b) : default<Secp256r1Point>;
  pt = disclose(result);
  return result;
}

export circuit guardedMul(enabled: Boolean, p: Secp256r1Point, k: Secp256r1Scalar): Secp256r1Point {
  const result = enabled ? ecMul(p, k) : default<Secp256r1Point>;
  pt = disclose(result);
  return result;
}

export circuit guardedGenerator(enabled: Boolean, k: Secp256r1Scalar): Secp256r1Point {
  const result = enabled ? ecMulGenerator(k) : default<Secp256r1Point>;
  pt = disclose(result);
  return result;
}

export pure circuit pureGroup(p: Secp256r1Point, k: Secp256r1Scalar): Secp256r1Point {
  return ecAdd(ecMul(p, k), ecMulGenerator(k));
}
