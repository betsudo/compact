import CompactStandardLibrary;

export ledger x: Secp256r1Base;
export ledger y: Secp256r1Base;

export circuit guardedX(enabled: Boolean, p: Secp256r1Point): Secp256r1Base {
  const value = enabled ? secp256r1PointX(p) : default<Secp256r1Base>;
  x = disclose(value);
  return value;
}

export circuit guardedY(enabled: Boolean, p: Secp256r1Point): Secp256r1Base {
  const value = enabled ? secp256r1PointY(p) : default<Secp256r1Base>;
  y = disclose(value);
  return value;
}
