import CompactStandardLibrary;
export circuit serialize_field(x: Field): Bytes<32> {
  return serialize<Field, 32>(x);
}
export circuit deserialize_field(x: Bytes<32>): Field {
  return deserialize<Field, 32>(x);
}

new type Element = Field;

export circuit pad_field(x: Element): Bytes<34> {
  return serialize<Element, 34>(x);
}

export circuit decode_field(x: Bytes<34>): Element {
  return deserialize<Element, 34>(x);
}

export circuit direct_short(x: Bytes<3>): Field {
  return x as Field;
}

export circuit direct_long(x: Bytes<33>): Field {
  return x as Field;
}
