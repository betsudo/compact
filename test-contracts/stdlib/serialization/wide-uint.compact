import CompactStandardLibrary;

new type Word = Uint<129>;
export circuit encode_word(x: Word): Bytes<20> { return serialize<Word, 20>(x); }
export circuit decode_word(x: Bytes<20>): Word { return deserialize<Word, 20>(x); }
export circuit encode_max(x: Uint<248>): Bytes<31> { return serialize<Uint<248>, 31>(x); }
export circuit decode_max(x: Bytes<31>): Uint<248> { return deserialize<Uint<248>, 31>(x); }
export circuit narrow(x: Uint<129>): Bytes<16> { return x as Bytes<16>; }
export circuit direct(x: Bytes<33>): Uint<129> { return x as Uint<129>; }
export circuit nested(x: [Boolean, Word]): Bytes<19> {
  return serialize<[Boolean, Word], 19>(x);
}
