import CompactStandardLibrary;
export circuit serialize_bytes(x: Bytes<10>): Bytes<10> {
  return serialize<Bytes<10>, 10>(x);
}
export circuit deserialize_bytes(x: Bytes<10>): Bytes<10> {
  return deserialize<Bytes<10>, 10>(x);
}

new type Payload = Bytes<2>;

export circuit pad_payload(x: Payload): Bytes<4> {
  return serialize<Payload, 4>(x);
}

export circuit decode_payload(x: Bytes<4>): Payload {
  return deserialize<Payload, 4>(x);
}

export circuit decode_empty(x: Bytes<4>): Bytes<0> {
  return deserialize<Bytes<0>, 4>(x);
}

export circuit pad_empty(x: Bytes<0>): Bytes<4> {
  return serialize<Bytes<0>, 4>(x);
}
