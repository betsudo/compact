import CompactStandardLibrary;
export enum Color { RED, GREEN, BLUE }
export circuit serialize_enum (c: Color): Bytes<1> {
  return serialize<Color, 1>(c);
}
export circuit deserialize_enum(c: Bytes<1>): Color {
  return deserialize<Color, 1>(c);
}
new type Shade = Color;
export enum UnitColor { BLACK }
export circuit padded(c: Shade): Bytes<3> { return serialize<Shade, 3>(c); }
export circuit unpadded(c: Bytes<3>): Shade { return deserialize<Shade, 3>(c); }
export circuit zero_encode(c: UnitColor): Bytes<0> { return serialize<UnitColor, 0>(c); }
export circuit zero_decode(c: Bytes<0>): UnitColor { return deserialize<UnitColor, 0>(c); }
export circuit checked_zero(valid: Boolean): Bytes<0> {
  return serialize<UnitColor, 0>(checked_color(valid));
}
circuit checked_color(valid: Boolean): UnitColor {
  assert(valid, "checked singleton input");
  return UnitColor.BLACK;
}
export circuit to_field(c: Color): Field { return c as Field; }
export circuit to_small(c: Color): Uint<1> { return c as Uint<1>; }
export circuit from_field(value: Field): Color { return value as Color; }
export circuit nested(c: [Color, Boolean]): Bytes<2> { return serialize<[Color, Boolean], 2>(c); }
