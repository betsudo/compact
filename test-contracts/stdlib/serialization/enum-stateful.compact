import CompactStandardLibrary;

export enum Color { RED, GREEN, BLUE }
export ledger stored: Color;

export circuit store_color(bytes: Bytes<1>): Color {
  const color = deserialize<Color, 1>(disclose(bytes));
  stored = color;
  return color;
}

// Exercise explicit casts in the stateful body as well as the pure codec.
export circuit store_ordinal(value: Uint<8>): Uint<1> {
  const color = disclose(value) as Color;
  stored = color;
  return color as Uint<1>;
}
