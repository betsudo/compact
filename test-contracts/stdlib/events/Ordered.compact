import CompactStandardLibrary;

export circuit ordered(active: Boolean, first: Bytes<32>, second: Bytes<32>): Field {
  if (disclose(active)) {
    emit(ShieldedSpend { nullifier: disclose(first) });
  }
  emit(ShieldedSpend { nullifier: disclose(second) });
  return 1;
}

export circuit rollback(ok: Boolean, n: Bytes<32>): Field {
  emit(ShieldedSpend { nullifier: disclose(n) });
  assert(ok, "rollback after event");
  return 1;
}
