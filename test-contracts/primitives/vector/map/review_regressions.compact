import CompactStandardLibrary;

export pure circuit bytes_map(left: Bytes<2>, right: Bytes<2>): Vector<2, Uint<16>> {
  return map((x: Uint<8>, y: Uint<8>): Uint<16> => (x * 2 + y) as Uint<16>, left, right);
}

export pure circuit widened_bytes_map(left: Bytes<2>, right: Bytes<2>): Vector<2, Uint<9>> {
  return map((x: Uint<9>, y: Uint<9>): Uint<9> => x, left, right);
}

export pure circuit widened_vector_map(left: Vector<2, Uint<8>>, right: Vector<2, Uint<8>>): Vector<2, Uint<16>> {
  return map((x: Uint<16>, y: Uint<16>): Uint<16> => x, left, right);
}
