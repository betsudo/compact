import CompactStandardLibrary;

export ledger digest: Bytes<64>;

export circuit hashEmpty(value: Bytes<0>): Bytes<64> {
  return disclose(sha512<Bytes<0>>(value));
}

export circuit hashOne(value: Bytes<1>): Bytes<64> {
  return disclose(sha512<Bytes<1>>(value));
}

export circuit hashTwo(value: Bytes<2>): Bytes<64> {
  return disclose(sha512<Bytes<2>>(value));
}

export circuit hashThree(value: Bytes<3>): Bytes<64> {
  return disclose(sha512<Bytes<3>>(value));
}

export circuit hashTuple(value: [Bytes<1>, Bytes<2>]): Bytes<64> {
  return disclose(sha512<[Bytes<1>, Bytes<2>]>(value));
}

export circuit hashField(value: Field): Bytes<64> {
  return disclose(sha512<Field>(value));
}

export circuit writeDigest(value: Bytes<64>): [] {
  digest = disclose(sha512<Bytes<64>>(value));
}

export circuit writePointDigest(value: [Bytes<2>, JubjubPoint, Bytes<1>]): [] {
  digest = disclose(sha512<[Bytes<2>, JubjubPoint, Bytes<1>]>(value));
}
